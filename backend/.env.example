# Local development only — never commit real secrets.
# Copy to .env and fill in values for your own machine.
PORT=5000
# Example: postgresql://USER:PASSWORD@localhost:5432/northbridge_health
DATABASE_URL=postgresql://localhost:5432/northbridge_health
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (no wildcard for auth).
CLIENT_ORIGIN=http://localhost:5173
